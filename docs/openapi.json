            "title": "Kind"
          },
          "text": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "title": "Title",
            "default": ""
          },
