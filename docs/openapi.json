              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Example Id"
          },
          "case": {
            "anyOf": [
              {
