      "CaseInput": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Id"
          },
          "patient_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Patient Id"
          },
          "task": {
            "type": "string",
            "enum": [
              "verification",
              "mcq",
              "synthesis"
            ],
            "title": "Task"
          },
          "question": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Question"
          },
          "verification_scheme": {
            "type": "string",
            "enum": [
              "refutes",
              "revisions"
            ],
            "title": "Verification Scheme",
            "default": "refutes"
          },
          "options": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "maxProperties": 30,
            "title": "Options"
          },
          "entities": {
            "$ref": "#/components/schemas/Entities"
          },
          "stage": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stage",
            "default": 0
          },
          "as_of_day": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of Day"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/Document"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Documents"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "synthetic",
              "deidentified",
              "unreviewed"
            ],
            "title": "Data Class",
            "default": "unreviewed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "patient_id",
          "task",
          "question"
        ],
        "title": "CaseInput"
      },
      "Document": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Id"
          },
          "origin_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
