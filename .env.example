# Export these variables in your shell; .env files are not loaded automatically.
ONCOFUSION_PROVIDER=mock
# For a real OpenAI-compatible Chat Completions endpoint:
# ONCOFUSION_PROVIDER=openai_compatible
# ONCOFUSION_BASE_URL=https://your-provider.example/v1
# ONCOFUSION_MODEL=your-model-id
# ONCOFUSION_API_KEY=replace-locally
# ONCOFUSION_JSON_MODE=true
# ONCOFUSION_TOKEN_PARAMETER=max_tokens
# ONCOFUSION_INPUT_PRICE=0
# ONCOFUSION_OUTPUT_PRICE=0
# Protect all /v1 routes before exposing the backend.
# ONCOFUSION_API_TOKEN=replace-with-a-long-random-token
ONCOFUSION_DB=runtime/oncofusion.sqlite3
# Optional compatibility switches for providers that reject sampling parameters:
# ONCOFUSION_SEND_TEMPERATURE=false
# ONCOFUSION_SEND_SEED=false
# ONCOFUSION_TIMEOUT=60
# ONCOFUSION_RETRIES=2
# Comma-separated explicit frontend origins (default: cross-origin access disabled).
# ONCOFUSION_CORS_ORIGINS=http://localhost:5173
